{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "importHelpers": true,
    "sourceMap": true,
    "strict": true,
    "useDefineForClassFields": false,
    "types": ["node"]
  },
  "include": [
    "src"
  ],
  "files": [
    "src/resource.d.ts"
  ]
}
